# Copy to .env.local and fill in. Set the same values in the Vercel project env.

# Supabase — set the service-role key (Dashboard → Settings → API Keys).
# SUPABASE_ANON_KEY works as a fallback while tables have RLS disabled.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Nutrition + ingredient parsing — Spoonacular (locked)
SPOONACULAR_API_KEY=

# Anthropic (LLM extraction fallback for social posts)
ANTHROPIC_API_KEY=

# Web search for discovery — Tavily (locked)
TAVILY_API_KEY=

# AnyList (unofficial lib — email/password auth)
ANYLIST_EMAIL=
ANYLIST_PASSWORD=
# Optional: name of the AnyList list to push to (default "Recipe App")
ANYLIST_LIST_NAME=
